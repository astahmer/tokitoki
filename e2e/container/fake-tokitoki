#!/bin/sh
set -eu

fixture_dir="${E2E_FIXTURE_DIR:-/opt/e2e/fixtures}"
command_log="${E2E_COMMAND_LOG:-/out/cli-invocations.jsonl}"
date_shift="${E2E_DATE_SHIFT_SECONDS:-0}"
prefs="${E2E_UI_PREFS:-/out/ui-prefs.json}"
[ -f "$prefs" ] || jq '[.limits[] | .provider + "@" + .accountKey] as $order | {accountOrder:$order, barHiddenAccounts:[], menubarHidden:[]}' "$fixture_dir/payload.json" > "$prefs"
subcommand="${1:-}"
[ "$#" -gt 0 ] && shift

if [ -n "$command_log" ]; then
  mkdir -p "$(dirname "$command_log")"
  jq -cn --args '$ARGS.positional' -- "$subcommand" "$@" >> "$command_log"
fi

rebase_dates() {
  jq --argjson offset "$date_shift" -f /opt/e2e/rebase-dates.jq
}

case "$subcommand" in
  widget-payload)
    mode=valid
    if [ -f /out/refresh-next ]; then
      mode=$(cat /out/refresh-next)
      rm /out/refresh-next
    fi
    printf '%s\n' "$mode" >> /out/refresh-results.log
    if [ "$mode" = failed ]; then
      printf '{"schema":1,"app":"tokitoki","limits":[]}\n'
      echo 'e2e injected failed refresh' >&2
      exit 17
    fi
    jq --slurpfile prefs "$prefs" --arg mode "$mode" '
      .uiPreview += $prefs[0]
      | if $mode == "null" then .limits = null
        elif $mode == "empty" then .limits = [] else . end
    ' "$fixture_dir/payload.json" | rebase_dates
    ;;
  ui)
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --account-order|--bar-account-order)
          key=accountOrder
          [ "$1" = --bar-account-order ] && key=barAccountOrder
          jq --arg key "$key" --arg order "$2" '.[$key] = ($order | split(","))' "$prefs" > "$prefs.next"
          shift 2
          ;;
        --hide|--show)
          jq --arg action "$1" --arg target "$2" '
            .menubarHidden = ((.menubarHidden // []) | map(select(. != $target)))
            | if $action == "--hide" then .menubarHidden += [$target] else . end
          ' "$prefs" > "$prefs.next"
          shift 2
          ;;
        --surface) shift 2; continue ;;
        *) exit 2 ;;
      esac
      mv "$prefs.next" "$prefs"
    done
    ;;
  config)
    if [ "${1:-}" = set ]; then
      case "${2:-}" in
        ui.previewHiddenAccounts)
          jq --argjson hidden "$3" '.barHiddenAccounts = $hidden' "$prefs" > "$prefs.next" ;;
        notifications.enabled)
          jq --argjson enabled "$3" '.notificationsEnabled = $enabled' "$prefs" > "$prefs.next" ;;
        *) cp "$prefs" "$prefs.next" ;;
      esac
      mv "$prefs.next" "$prefs"
    fi
    ;;
  sessions)
    search=""
    page=1
    top=25
    session_id=""
    provider=""
    events_limit=40
    events_offset=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --search) search="${2:-}"; shift 2 ;;
        --page) page="${2:-1}"; shift 2 ;;
        --top) top="${2:-25}"; shift 2 ;;
        --session) session_id="${2:-}"; shift 2 ;;
        --provider) provider="${2:-}"; shift 2 ;;
        --events-limit) events_limit="${2:-40}"; shift 2 ;;
        --events-offset) events_offset="${2:-0}"; shift 2 ;;
        *) shift ;;
      esac
    done

    if [ -n "$session_id" ]; then
      jq --arg sessionId "$session_id" \
        --arg provider "${provider:-codex}" \
        --argjson offset "$events_offset" \
        --argjson limit "$events_limit" \
        '.sessionId = $sessionId
         | .provider = $provider
         | .eventsTotal as $total
         | .events = [.events[$offset:($offset + $limit)][]]
         | .eventsOffset = $offset
         | .eventsHasMore = ($offset + (.events | length) < $total)' \
        "$fixture_dir/session-detail.json" | rebase_dates
      exit 0
    fi

    if [ -n "$search" ]; then
      jq --arg query "$search" --argjson page "$page" --argjson top "$top" '
        ([ $query | ascii_downcase | split(" ")[] | select(length > 0) ]) as $terms
        | [ .rows[]
            | ([.title // "", .snippet // "", .provider // "", .accountKey // ""]
               | join(" ") | ascii_downcase) as $text
            | select(all($terms[]; . as $term | $text | contains($term))) ] as $matches
        | .query = $query
        | .page = $page
        | .hasMore = (($page * $top) < ($matches | length))
        | .rows = [$matches[((($page - 1) * $top)):($page * $top)][]
            | .snippet |= gsub("(?i)(?<hit>" + $query + ")"; "[[\(.hit)]]")
            | .lastRequestAt = .startedAt
            | .models = (.models // [])]
        | del(.top)
      ' "$fixture_dir/sessions.json" | rebase_dates
      exit 0
    fi

    if [ "$page" -gt 1 ]; then
      jq --argjson page "$page" --argjson top "$top" '
        .page = $page
        | .top = $top
        | if $page == 2 then . else (.rows = [] | .hasMore = false) end
      ' "$fixture_dir/sessions-page-2.json" | rebase_dates
    else
      jq --argjson top "$top" '.page = 1 | .top = $top' "$fixture_dir/sessions.json" | rebase_dates
    fi
    ;;
  *)
    exit 0
    ;;
esac
